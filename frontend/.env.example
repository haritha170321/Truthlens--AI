# TruthLens AI – Frontend Environment Variables
# -----------------------------------------------
# Copy this file to .env (never commit .env with real credentials)

# REQUIRED for production/deployed builds:
# Set this to your deployed backend URL (no trailing slash).
# On Netlify: Site settings → Environment variables → Add variable
#
# Examples:
#   VITE_API_URL=https://your-backend.railway.app
#   VITE_API_URL=https://your-backend.onrender.com
#   VITE_API_URL=https://your-backend.fly.dev
#
# Leave empty for local dev (Vite proxy in vite.config.js handles routing to localhost:5000)
VITE_API_URL=

# Google OAuth 2.0 Web Client ID
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
# To configure:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# 2. Create Credentials -> OAuth client ID -> Application type: Web application
# 3. Add Authorized JavaScript origins: http://localhost:5173
# 4. Paste your Client ID below:
VITE_GOOGLE_CLIENT_ID=

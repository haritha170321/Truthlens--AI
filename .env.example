# ==============================================================================
# TruthLens AI – Environment Configuration Template
# Platform: Explainable Misinformation Analysis and Verification Platform
# ==============================================================================

# --- Node.js Backend Gateway Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database Configuration ---
# Local MongoDB or MongoDB Atlas URI.
# If unavailable, TruthLens AI automatically uses high-performance in-memory persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/truthlens_db

# --- Security & Authentication ---
JWT_SECRET=truthlens_ai_cryptographic_jwt_token_secret_2026_sdg16
JWT_EXPIRES_IN=7d

# --- Python AIML Microservice Gateway ---
ML_SERVICE_URL=http://localhost:8000

# --- Optional External AI & News Retrieval APIs ---
# The platform includes complete local ML inference, offline IFCN fact-checking database,
# and Wikipedia live retrieval. External APIs are purely optional extensions.
GEMINI_API_KEY=
NEWS_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
TAVILY_API_KEY=

# --- Multilingual & Feature Toggles ---
DEFAULT_LANGUAGE=en
ENABLE_TAMIL_PIPELINE=true
ENABLE_3D_VISUALIZER=true
ENABLE_OFFLINE_DEMO_MODE=true
